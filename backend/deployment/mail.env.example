# Root-only production EnvironmentFile. Replace placeholders; never package the real file.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-sender@qq.com
SMTP_PASSWORD=replace-with-mail-authorization-code
OTP_SECRET=replace-with-a-long-random-server-secret
QINGLIAO_REQUIRE_EMAIL=1
QINGLIAO_REQUIRE_E2EE=1

# Only trust the loopback nginx proxy; never expose backend port 8765.
QINGLIAO_TRUST_PROXY=1
QINGLIAO_REGISTRATION_OPEN=1
MAX_STORAGE_MB=1024
USER_STORAGE_MB=200
MIN_FREE_MB=64
