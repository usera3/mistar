# Copy to .env, fill in your own values and keep it private.
# The backend reads process environment, not dotenv files. Export these variables
# in your shell or use a root-owned systemd EnvironmentFile.
QINGLIAO_DATA=/var/lib/qingliao
PORT=8765
PUBLIC_IP=203.0.113.10
QINGLIAO_REQUIRE_EMAIL=1
QINGLIAO_REQUIRE_E2EE=1
QINGLIAO_PUBLIC_PLAZA=0
QINGLIAO_REGISTRATION_OPEN=1
QINGLIAO_TRUST_PROXY=1
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-sender@example.com
SMTP_PASSWORD=replace-with-your-mail-authorization-code
OTP_SECRET=replace-with-a-cryptographically-random-server-secret
TURN_SECRET=replace-with-a-different-cryptographically-random-secret
MAX_STORAGE_MB=1024
USER_STORAGE_MB=200
MIN_FREE_MB=64
